# Python
.venv/
__pycache__/
*.pyc
*.pyo
*.spec

# PyInstaller output
build/
dist/

# SQLite (per-user data, never commit)
data/finance.db
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm

# Session signing key, generated on first run and cached beside the database.
data/.secret_key

# App Hub bundles, rebuilt by _build_zip.py on demand (one per install)
finance-*.zip

# SSH credentials for the Pi. SetupGithub.bat runs `git add -A`, so this needs
# to be ignored rather than merely untracked.
Connect to Pi info.txt

# App Hub's own developer guide, kept here only as a working reference. It
# documents the Pi's SSH user, tailnet hostname and the hub's SSO secret, and
# this repository is public.
APP-GUIDE.md

# Tauri / Rust
src-tauri/target/
src-tauri/gen/schemas/
src-tauri/binaries/*.exe

# Build & runtime logs
tauri-build.log
tauri-bundle.log
tauri-app-*.log
sidecar-*.log

# Source PNG for the icon suite (regenerable via cargo tauri icon)
app-icon.png

# OS / editor noise
Thumbs.db
.DS_Store
.vscode/
.idea/
