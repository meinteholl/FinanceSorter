# cmd.exe seeks by byte offset when running a .bat file and assumes CRLF.
# With LF-only endings the offsets drift, so `goto` lands mid-line: build.bat
# silently fell through its error path, and DeployUpdate.bat garbled outright.
# Force CRLF on checkout so these always run correctly on Windows.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# The mirror image on the Pi: a shell script with CRLF fails at exec time with
# "bad interpreter: /usr/bin/env bash^M". App Hub runs setup.sh and run.sh
# directly, so these must stay LF whatever the checkout platform.
*.sh text eol=lf
