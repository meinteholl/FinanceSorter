{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Finance Sorter",
  "version": "0.1.12",
  "identifier": "com.financesorter.app",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Finance Sorter",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 650,
        "resizable": true,
        "visible": false,
        "center": true,
        "decorations": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/finance-sorter-backend"],
    "windows": {
      "wix": { "language": ["en-US"] }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlEQ0Y5NjU5MDA0RUE4N0MKUldSOHFFNEFXWmJQblJFeWN3VmJLM0FML0gwZ0l0RElPYWtNMHpDbk9DQWZUZkdsM3JYVEVmWFoK",
      "endpoints": [
        "https://github.com/meinteholl/FinanceSorter/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
