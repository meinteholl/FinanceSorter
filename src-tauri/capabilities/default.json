{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Allow the main window to spawn the bundled Flask sidecar",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "updater:default",
    "shell:allow-execute",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/finance-sorter-backend",
          "sidecar": true,
          "args": [
            "--port",
            { "validator": "^\\d{2,5}$" },
            "--parent-pid",
            { "validator": "^\\d{1,10}$" }
          ]
        }
      ]
    }
  ]
}
